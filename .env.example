# Copy to .env and fill in values from your browser (DevTools → Network -> Refresh -> Click top result in network (www.albumoftheyear.org) → Cookie + User-Agent)

AOTY_COOKIES=cf_clearance=...; PHPSESSID=...
AOTY_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/154.0.0.0 Safari/537.36
